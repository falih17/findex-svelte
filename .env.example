# ==========================================================
# ENVIRONMENT VARIABLES CONFIGURATION (DOCKER)
# ==========================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=debug

# 1. PostgreSQL + PostGIS + pgvector
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=findex_db
POSTGRES_USER=findex_user
POSTGRES_PASSWORD=findex_secret_pwd
DATABASE_URL=postgres://findex_user:findex_secret_pwd@postgres:5432/findex_db?sslmode=disable

# 2. Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_pwd

# 3. MinIO (Local S3-Compatible Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_BIOMETRICS=findex-biometrics
MINIO_BUCKET_ATTENDANCES=findex-attendances
MINIO_BUCKET_DOCS=findex-documents

# 4. AI Face Recognition Service (Python)
AI_SERVICE_URL=http://ai-face-service:8000
FACE_SIMILARITY_THRESHOLD=0.80

# 5. Backend Core (Golang)
BACKEND_PORT=8080
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long!
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 6. Frontend (SvelteKit)
PUBLIC_API_URL=http://localhost:8080/api/v1
PUBLIC_MINIO_URL=http://localhost:9000
